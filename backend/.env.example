MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?appName=<app>
JWT_SECRET=<gere-uma-chave-aleatoria-longa>
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<defina-uma-senha-forte>
PORT=3001
FRONTEND_URL=http://localhost:3000

# Mercado Pago — Access Token (Checkout Pro). NUNCA commitar o valor real.
MP_ACCESS_TOKEN=APP_USR-...
# URL pública https desta API para o webhook do MP (ex.: https://andrevendas-api.fly.dev)
PUBLIC_API_URL=
# URL completa da página de retorno do checkout (inclui basePath em produção)
CHECKOUT_RETURN_URL=

# Cloudinary — armazenamento persistente das imagens (console.cloudinary.com/app/settings/api-keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
